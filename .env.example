# Copy to .env and adjust per environment. Never commit real secrets.
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5180
WEB_PORT=5181
# Public URL the browser uses to reach the API.
API_BASE_URL=http://localhost:5180
# Origin allowed by the API CORS policy.
WEB_ORIGIN=http://localhost:5181


# Shared local PostgreSQL (compose.postgres-local.yaml), superuser "postgres"
POSTGRES_LOCAL_PORT=5433
POSTGRES_LOCAL_PASSWORD=change-me

# Petyei database and role inside postgres-local
PETYEI_DB_NAME=petyei_local
PETYEI_DB_USER=petyei
PETYEI_DB_PASSWORD=change-me
